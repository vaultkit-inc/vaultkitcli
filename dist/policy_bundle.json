      "description": "Block access when requester and dataset are in different regions.",
      "match": {
        "dataset": "customers",
        "context": {
          "dataset_region": "EU",
          "requester_region": "US"
        }
      },
      "action": "deny",
      "reason": "Cross-region access is not allowed."
    },
    {
      "id": "financial_requires_approval",
      "description": "Access to financial data requires manual approval.",
      "match": {
        "dataset": "customers",
        "fields": {
          "category": "financial"
        }
      },
      "when": {
        "requester_role": "analyst",
        "environment": "production"
      },
      "action": "require_approval",
      "reason": "Financial data requires review before release.",
      "approval": {
        "approver_role": "finance_manager"
      },
      "ttl_seconds": "1h"
    },
    {
      "id": "mask_non_id_fields_for_support",
      "description": "Support agents can view only IDs; all other fields must be masked.",
      "match": {
        "dataset": "customers",
        "context": {
          "requester_role": "support"
        }
      },
      "action": "mask",
      "reason": "Support role can only see customer identifiers.",
      "ttl_seconds": "1h"
    },
    {
      "id": "mask_pii_for_analysts",
      "description": "Mask PII fields unless the requester is admin.",
      "match": {
        "dataset": "customers",
        "context": {
          "requester_role": "analyst"
        },
        "fields": {
          "sensitivity": "pii"
        }
      },
      "action": "mask",
      "reason": "Analysts must not see raw personally identifiable information.",
      "ttl_seconds": "1h"
    },
    {
      "id": "require_approval_for_financial",
      "description": "Financial fields require approval before access.",
      "match": {
