#!/usr/bin/env ruby

require_relative "../lib/vkit"
require_relative "../lib/vkit/cli/errors"

begin
  Vkit::CLI.start(ARGV)

rescue Vkit::CLI::Error => e
  warn "❌ #{e.message}"
  fix = Vkit::CLI::ErrorMap.human_fix(e)
  warn "   Fix: #{fix}" if fix
  exit 1

rescue Vkit::CLI::API::APIError => e
  warn e.message
  fix = Vkit::CLI::ErrorMap.human_fix(e)
  warn "Fix: #{fix}" if fix
  exit 1

rescue Thor::Error => e
  warn "❌ #{e.message}"
  exit 1

rescue Interrupt
  warn "\n⏹️  Interrupted"
  exit 130

rescue => e
  warn e.message

  # Only show stack trace when debugging
  if ENV["VKIT_DEBUG"] == "true"
    warn e.backtrace.join("\n")
  end

  exit 1
end
